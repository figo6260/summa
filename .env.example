# Summa — environment configuration.
#
# Docker release (recommended): copy this file to `.env`, set the two
# required secrets (POSTGRES_PASSWORD, SESSION_SECRET), then run
#   docker compose -f docker-compose.release.yml up -d --build
# The release compose file consumes the [compose] variables below and
# assembles DATABASE_URL for the app container itself.
#
# Host install (no Docker): set DATABASE_URL instead of the POSTGRES_*
# variables, then
#   npm ci && npx prisma db push && npm run build && npm run start

# --- Database [compose] ---------------------------------------------------
POSTGRES_USER=summa
# REQUIRED (compose). Password of the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=summa

# --- Database [host install only] -----------------------------------------
# REQUIRED for host installs. Ignored by the release compose file,
# which builds this value from the POSTGRES_* variables above.
# DATABASE_URL=postgresql://summa:change-me@localhost:5432/summa

# --- Sessions ---------------------------------------------------------------
# REQUIRED. Signs the session cookies. At least 16 characters; in
# production the app refuses to start without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Defaults to "true". Set to "false" ONLY when evaluating over plain
# http:// (e.g. http://localhost) — browsers drop Secure cookies on
# http origins, so sign-in cannot persist with "true" there.
# SESSION_COOKIE_SECURE=false

# --- Public URL ---------------------------------------------------------------
# Public base URL of this install. Used to build activation links in
# invite emails when there is no request context (e.g. CLI tools).
APP_BASE_URL=http://localhost:3000
# Host port the release compose file publishes the app on [compose].
APP_PORT=3000

# --- Transactional mail ---------------------------------------------------------
# "log" (the default) records every email in the EmailLog table —
# visible under /admin/emails — without sending anything. Right for
# evaluation and for installs without an SMTP server.
# "smtp" delivers through the SMTP settings below.
MAIL_TRANSPORT=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Summa <no-reply@example.com>

# --- Stripe adapter (optional) ----------------------------------------------------
# Webhook signing secret of your Stripe webhook endpoint (Stripe
# dashboard → Developers → Webhooks → your endpoint → Signing secret).
# Until this is set, POST /api/webhooks/stripe answers 503
# (stripe_webhook_not_configured) and no Stripe events are processed.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Conversion API -------------------------------------------------------------------
# Per-API-key rate limit for POST /api/v1/conversions, in requests
# per minute. Default 300.
# SUMMA_API_RATE_LIMIT=300

# --- Docker build (optional) ------------------------------------------------------------
# npm registry used while building the Docker image, e.g. a regional
# mirror: NPM_REGISTRY=https://registry.npmmirror.com
# NPM_REGISTRY=
